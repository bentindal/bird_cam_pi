TELEGRAM_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
HF_API_KEY=your_huggingface_api_key_here

# Camera source: 0 for Mac webcam, "picamera" for Pi Camera
CAMERA_SOURCE=0

# Motion detection sensitivity (lower = more sensitive)
MOTION_THRESHOLD=500
MIN_CONTOUR_AREA=1500

# Seconds between Telegram notifications (cooldown)
NOTIFICATION_COOLDOWN=30

# Pre/post trigger clip duration in seconds
PRE_BUFFER_SECONDS=3
POST_TRIGGER_SECONDS=7

# HTTP stream port
STREAM_PORT=5000
